# Neon PostgreSQL Pooled Connection URL (for runtime queries)
# Get this from your Neon dashboard: Project Settings > Connection Details > Pooled
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"

# Neon PostgreSQL Direct Connection URL (for migrations)
# Get this from your Neon dashboard: Project Settings > Connection Details > Direct Connection
DIRECT_URL="postgresql://user:password@host:port/database"

# Secret for NextAuth.js session encryption
# Generate with: npx auth secret or openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
